<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<StackPane prefWidth="1920.0" prefHeight="1080.0"
           stylesheets="@../css/style.css"
           xmlns="http://javafx.com/javafx/19"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.ingsw.client.GUI.SplashController">

    <styleClass>
        <String fx:value="testo-personalizzato" />
    </styleClass>

    <children>
        <ImageView fitHeight="1080.0" fitWidth="1920.0" pickOnBounds="true">
            <image>
                <Image url="@../images/SfondoLogin.png" />
            </image>
            <effect>
                <GaussianBlur radius="63.0" />
            </effect>
        </ImageView>

        <Rectangle width="1920.0" height="1080.0" opacity="0.5"
                   stroke="BLACK" strokeType="INSIDE"
                   arcWidth="5.0" arcHeight="5.0" />

        <VBox alignment="CENTER" spacing="28.0">
            <children>
                <ImageView pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="/images/mesos_fire_final.gif" />
                    </image>
                </ImageView>

                <Label fx:id="loadingLabel" text="Caricamento risorse" styleClass="testo-personalizzato"
                       style="-fx-text-fill: #d8ceb1; -fx-font-size: 35px; -fx-effect: dropshadow(gaussian, black, 7, 0.7, 0, 0);">
                </Label>
            </children>
        </VBox>

    </children>
</StackPane>