<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import java.lang.String?>
<StackPane fx:id="root"
           maxWidth="Infinity" maxHeight="Infinity"
           stylesheets="@../css/style.css"
           xmlns="http://javafx.com/javafx/19"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.ingsw.client.ui.gui.SplashController">

    <styleClass>
        <String fx:value="personalized-text" />
    </styleClass>

    <children>
        <ImageView fitWidth="${root.width}" fitHeight="${root.height}"
                   pickOnBounds="true" preserveRatio="false">
            <image>
                <Image url="@../images/LoginBackground.png" />
            </image>
            <effect>
                <GaussianBlur radius="63.0" />
            </effect>
        </ImageView>

        <Rectangle width="${root.width}" height="${root.height}"
                   opacity="0.5" stroke="BLACK" strokeType="INSIDE"
                   arcWidth="5.0" arcHeight="5.0" />

        <VBox alignment="CENTER" spacing="28.0">
            <children>
                <ImageView pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="/images/mesos_fire_final.gif" />
                    </image>
                </ImageView>

                <Label fx:id="loadingLabel" text="Caricamento risorse"
                       styleClass="personalized-text"
                       style="-fx-text-fill: #d8ceb1; -fx-font-size: 35px;
                              -fx-effect: dropshadow(gaussian, black, 7, 0.7, 0, 0);" />
            </children>
        </VBox>
    </children>
</StackPane>