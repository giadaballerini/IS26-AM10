<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<StackPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <ImageView fitHeight="1280.0" fitWidth="1920.0" pickOnBounds="true">
         <image>
            <Image url="@SfondoLogin.png" />
         </image>
         <effect>
            <GaussianBlur radius="63.0" />
         </effect>
      </ImageView>
      <Rectangle arcHeight="5.0" arcWidth="5.0" height="1280.0" opacity="0.5" stroke="BLACK" strokeType="INSIDE" width="1920.0" />
      <ImageView fitHeight="964.0" fitWidth="1196.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@SfondoLogin.png" />
         </image>
      </ImageView>
      <HBox alignment="BOTTOM_CENTER" prefHeight="1008.0" prefWidth="1920.0" spacing="90.0" translateY="-180.0">
         <children>
            <Button minHeight="60.0" minWidth="250.0" mnemonicParsing="false" styleClass="bottone-mesos" text="Connessione RMI">
               <font>
                  <Font size="23.0" />
               </font>
            </Button>
            <Button minHeight="60.0" minWidth="250.0" mnemonicParsing="false" styleClass="bottone-mesos" text="Connessione Socket">
               <font>
                  <Font size="23.0" />
               </font>
            </Button>
         </children>
         <StackPane.margin>
